# Railway Variables > RAW Editor (.env format)
# Keep only per-instance values here. The image includes appsettings.json and EVMChains.json defaults.
# Replace the ApiToken sample and fill the address/Telegram values before accepting payments.

# Required instance settings
ApiToken=REPLACE_WITH_A_LONG_RANDOM_SECRET
WebSiteUrl=https://your-tokenpay-domain.example
TOKENPAY_OVERRIDE__Address__TRON__0=
TOKENPAY_OVERRIDE__Telegram__AdminUserId=
TOKENPAY_OVERRIDE__Telegram__BotToken=

# Production recommendation
TOKENPAY_OVERRIDE__TRON-PRO-API-KEY=

# Current image default uses static addresses. Set true only when using dynamic addresses.
TOKENPAY_OVERRIDE__UseDynamicAddress=false
# Optional EVM address; set an address before enabling an EVM chain.
TOKENPAY_OVERRIDE__Address__EVM__0=
# Optional BSC-specific address; otherwise the shared EVM address is used.
# TOKENPAY_OVERRIDE__Address__BSC__0=

# Optional admin panel. Keep disabled unless username and password hash are configured.
# Admin__Enabled=true
# Admin__Username=admin
# Admin__PasswordHash=REPLACE_WITH_HASHED_PASSWORD
# Admin__RequireHttps=true

# Optional payment page theme; leave blank for the classic theme.
TOKENPAY_OVERRIDE__ThemeName=

# EVM chains are disabled in the image defaults. Before enabling one, set its API key:
# TOKENPAY_OVERRIDE__EVMChains__0__Enable=true
# TOKENPAY_OVERRIDE__EVMChains__0__ApiKey=
# Index 0=ETH, 1=BSC, 2=Polygon.
